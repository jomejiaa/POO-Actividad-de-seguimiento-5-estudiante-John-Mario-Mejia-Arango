    private void btnAceptarActionPerformed(java.awt.event.ActionEvent evt) {                                           
        int numero = (int) spnHabitacion.getValue();

        if (hotel.buscarHabitacionOcupada(numero)) {

            javax.swing.JOptionPane.showMessageDialog(
                    this,
                    "La habitación " + numero + " está ocupada.",
                    "Habitación no disponible",
                    javax.swing.JOptionPane.ERROR_MESSAGE
            );

        } else {

            VentanaIngreso ventanaIngreso =
                    new VentanaIngreso(hotel, numero);

            ventanaIngreso.setLocationRelativeTo(this);
            ventanaIngreso.setVisible(true);

            dispose();
        }
    }                                          

