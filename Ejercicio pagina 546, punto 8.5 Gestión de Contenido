    private void btnCalcularActionPerformed(java.awt.event.ActionEvent evt) {                                            

    String textoFechaSalida = txtFechaSalida.getText().trim();

    lblCantidadDias.setText("—");
    lblTotalPagar.setText("$0");
    btnRegistrarSalida.setEnabled(false);

    if (textoFechaSalida.isEmpty()) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Debe ingresar la fecha de salida.",
                "Campo obligatorio",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

    try {
        if (!textoFechaSalida.matches("\\d{4}-\\d{2}-\\d{2}")) {

            throw new java.time.format.DateTimeParseException(
                    "Formato incorrecto",
                    textoFechaSalida,
                    0
            );
        }
        java.time.LocalDate fechaSalida =
                java.time.LocalDate.parse(textoFechaSalida);
        java.util.Date fechaIngresoRegistrada =
                habitacionOcupada.getHuesped().getFechaIngreso();
        java.time.LocalDate fechaIngreso =
                fechaIngresoRegistrada.toInstant()
                        .atZone(java.time.ZoneId.systemDefault())
                        .toLocalDate();
        if (!fechaSalida.isAfter(fechaIngreso)) {

            javax.swing.JOptionPane.showMessageDialog(
                    this,
                    "La fecha de salida debe ser posterior "
                    + "a la fecha de ingreso.\n"
                    + "Fecha de ingreso: " + fechaIngreso,
                    "Error de fecha",
                    javax.swing.JOptionPane.ERROR_MESSAGE
            );

            return;
        }

    long dias = java.time.temporal.ChronoUnit.DAYS.between(
            fechaIngreso,
            fechaSalida
    );

    double precioDia = habitacionOcupada.getPrecioDia();

    double totalPagar = dias * precioDia;

    lblCantidadDias.setText(String.valueOf(dias));

    java.text.NumberFormat formatoMoneda =
            java.text.NumberFormat.getCurrencyInstance(
                    new java.util.Locale("es", "CO")
            );

    lblTotalPagar.setText(formatoMoneda.format(totalPagar));

    btnRegistrarSalida.setEnabled(true);
    txtFechaSalida.setEditable(false);

    } catch (java.time.format.DateTimeParseException e) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "La fecha de salida no es válida.\n"
                + "Debe utilizar el formato aaaa-mm-dd.",
                "Error de fecha",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );
    }

    }                                           

    private void btnRegistrarSalidaActionPerformed(java.awt.event.ActionEvent evt) {                                                   
    if (!btnRegistrarSalida.isEnabled()) {
        return;
    }

    if (habitacionOcupada == null
            || habitacionOcupada.getDisponible()
            || habitacionOcupada.getHuesped() == null) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "La habitación no tiene un huésped registrado.",
                "Error de salida",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

    java.time.LocalDate fechaSalida =
            java.time.LocalDate.parse(
                    txtFechaSalida.getText().trim()
            );

    java.util.Date fechaRegistroSalida =
            java.util.Date.from(
                    fechaSalida.atStartOfDay(
                            java.time.ZoneId.systemDefault()
                    ).toInstant()
            );

    habitacionOcupada.getHuesped().setFechaSalida(
            fechaRegistroSalida
    );

    habitacionOcupada.setHuesped(null);
    habitacionOcupada.setDisponible(true);

    javax.swing.JOptionPane.showMessageDialog(
            this,
            "La salida del huésped se ha registrado correctamente.\n"
            + "Habitación: " + numeroHabitacion + "\n"
            + "Días de alojamiento: " + lblCantidadDias.getText() + "\n"
            + "Total a pagar: " + lblTotalPagar.getText() + "\n"
            + "La habitación ahora está disponible.",
            "Salida registrada",
            javax.swing.JOptionPane.INFORMATION_MESSAGE
    );

    dispose();
    }                                                  

