    private void btnAceptarActionPerformed(java.awt.event.ActionEvent evt) {                                           
    String fechaIngreso = txtFechaIngreso.getText().trim();
    String nombres = txtNombres.getText().trim();
    String apellidos = txtApellidos.getText().trim();
    String documento = txtDocumento.getText().trim();

    if (fechaIngreso.isEmpty() || nombres.isEmpty()
            || apellidos.isEmpty() || documento.isEmpty()) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Todos los campos son obligatorios.",
                "Error de validación",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

try {

    if (!fechaIngreso.matches("\\d{4}-\\d{2}-\\d{2}")) {
        throw new java.time.format.DateTimeParseException(
                "Formato incorrecto", fechaIngreso, 0);
    }

    java.time.LocalDate fecha =
            java.time.LocalDate.parse(fechaIngreso);

    if (!nombres.matches("[\\p{L}]+(?:[ ]+[\\p{L}]+)*")) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Los nombres solo deben contener letras y espacios.",
                "Error de validación",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

    if (!apellidos.matches("[\\p{L}]+(?:[ ]+[\\p{L}]+)*")) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Los apellidos solo deben contener letras y espacios.",
                "Error de validación",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

    if (!documento.matches("[0-9]+")) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "El documento de identidad debe contener solo números.",
                "Error de validación",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

    try {

        int numeroDocumento = Integer.parseInt(documento);

        if (numeroDocumento <= 0) {
            throw new NumberFormatException();
        }

    } catch (NumberFormatException e) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "El documento debe ser un número positivo "
                + "dentro del rango permitido.",
                "Error de validación",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }
    
    int numeroDocumento = Integer.parseInt(documento);

    Habitacion habitacion =
            hotel.buscarHabitacion(numeroHabitacion);

    if (habitacion == null || !habitacion.getDisponible()) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "La habitación seleccionada no está disponible.",
                "Error de registro",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );

        return;
    }

    Huesped huesped = new Huesped(
            nombres,
            apellidos,
            numeroDocumento
    );

    java.util.Date fechaRegistro = java.util.Date.from(
            fecha.atStartOfDay(
                    java.time.ZoneId.systemDefault()
            ).toInstant()
    );

    huesped.setFechaIngreso(fechaRegistro);

    habitacion.setHuesped(huesped);

    habitacion.setDisponible(false);

    javax.swing.JOptionPane.showMessageDialog(
            this,
            "El huésped ha sido registrado correctamente.\n"
            + "Habitación: " + numeroHabitacion + "\n"
            + "Huésped: " + nombres + " " + apellidos,
            "Registro exitoso",
            javax.swing.JOptionPane.INFORMATION_MESSAGE
    );

    dispose();


} catch (java.time.format.DateTimeParseException e) {

    javax.swing.JOptionPane.showMessageDialog(
            this,
            "La fecha de ingreso no es válida.\n"
            + "Debe utilizar el formato aaaa-mm-dd.",
            "Error de fecha",
            javax.swing.JOptionPane.ERROR_MESSAGE
    );
    }
    }                                          

