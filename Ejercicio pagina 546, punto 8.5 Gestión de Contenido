//Habitacion.java

package com.mycompany.ejerciciopag546;

public class Habitacion {

    private int numeroHabitacion;
    private boolean disponible;
    private double precioDia;
    private Huesped huesped;

    public Habitacion(int numeroHabitacion, boolean disponible,
                     double precioDia) {
        this.numeroHabitacion = numeroHabitacion;
        this.disponible = disponible;
        this.precioDia = precioDia;
        this.huesped = null;
    }

    public int getNumeroHabitacion() {
        return numeroHabitacion;
    }

    public boolean getDisponible() {
        return disponible;
    }

    public double getPrecioDia() {
        return precioDia;
    }

    public Huesped getHuesped() {
        return huesped;
    }

    public void setHuesped(Huesped huesped) {
        this.huesped = huesped;
    }

    public void setDisponible(boolean disponible) {
        this.disponible = disponible;
    }
}

//Hotel.java

package com.mycompany.ejerciciopag546;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Vector;

public class Hotel {

    private final Vector<Habitacion> listaHabitaciones;

    public Hotel() {

        listaHabitaciones = new Vector<>();

        for (int i = 1; i <= 10; i++) {

            double precioDia;

            if (i <= 5) {
                precioDia = 120000;
            } else {
                precioDia = 160000;
            }

            Habitacion habitacion =
                    new Habitacion(i, true, precioDia);

            listaHabitaciones.add(habitacion);
        }
    }

    public Vector<Habitacion> getListaHabitaciones() {
        return listaHabitaciones;
    }

    public Habitacion buscarHabitacion(int numero) {

        for (Habitacion habitacion : listaHabitaciones) {

            if (habitacion.getNumeroHabitacion() == numero) {
                return habitacion;
            }
        }

        return null;
    }

    public boolean buscarHabitacionOcupada(int numero) {

        Habitacion habitacion = buscarHabitacion(numero);

        if (habitacion != null) {
            return !habitacion.getDisponible();
        }

        return false;
    }

    public String buscarFechaIngresoHabitacion(int numero) {

        Habitacion habitacion = buscarHabitacion(numero);

        if (habitacion != null
                && habitacion.getHuesped() != null) {

            Date fecha =
                    habitacion.getHuesped().getFechaIngreso();

            if (fecha != null) {

                SimpleDateFormat formatoFecha =
                        new SimpleDateFormat("yyyy-MM-dd");

                return formatoFecha.format(fecha);
            }
        }

        return "";
    }
}

//Huesped.java

package com.mycompany.ejerciciopag546;

import java.util.Date;
import java.time.LocalDate;
import java.time.ZoneId;
import java.time.temporal.ChronoUnit;

public class Huesped {

    private String nombres;
    private String apellidos;
    private int documentoIdentidad;
    private Date fechaIngreso;
    private Date fechaSalida;

    public Huesped(String nombres, String apellidos,
                   int documentoIdentidad) {
        this.nombres = nombres;
        this.apellidos = apellidos;
        this.documentoIdentidad = documentoIdentidad;
    }

    public void setFechaIngreso(Date fecha) {
        this.fechaIngreso = fecha;
    }

    public void setFechaSalida(Date fecha) {
        this.fechaSalida = fecha;
    }

    public Date getFechaIngreso() {
        return fechaIngreso;
    }

    public Date getFechaSalida() {
        return fechaSalida;
    }

    public String getNombres() {
        return nombres;
    }

    public String getApellidos() {
        return apellidos;
    }

    public int getDocumentoIdentidad() {
        return documentoIdentidad;
    }

    public int obtenerDiasAlojamiento() {

        LocalDate ingreso = fechaIngreso.toInstant()
                .atZone(ZoneId.systemDefault())
                .toLocalDate();

        LocalDate salida = fechaSalida.toInstant()
                .atZone(ZoneId.systemDefault())
                .toLocalDate();

        return (int) ChronoUnit.DAYS.between(ingreso, salida);
    }
}

