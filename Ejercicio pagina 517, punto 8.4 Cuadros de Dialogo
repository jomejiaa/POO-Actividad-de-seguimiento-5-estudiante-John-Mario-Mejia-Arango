    private void btnAgregarActionPerformed(java.awt.event.ActionEvent evt) {                                           

    try {

        String nombre = txtNombre.getText().trim();
        String apellidos = txtApellidos.getText().trim();

        if (nombre.isEmpty() || apellidos.isEmpty()) {
            javax.swing.JOptionPane.showMessageDialog(
                    this,
                    "Debe ingresar el nombre y los apellidos.",
                    "Error",
                    javax.swing.JOptionPane.ERROR_MESSAGE);
            return;
        }

        TipoCargo cargo;

        switch (cmbCargo.getSelectedIndex()) {
            case 0:
                cargo = TipoCargo.DIRECTIVO;
                break;
            case 1:
                cargo = TipoCargo.ESTRATEGICO;
                break;
            default:
                cargo = TipoCargo.OPERATIVO;
                break;
        }

        TipoGenero genero;

        if (rbtnMasculino.isSelected()) {
            genero = TipoGenero.MASCULINO;
        } else {
            genero = TipoGenero.FEMENINO;
        }

        double salarioDia = Double.parseDouble(
                txtSalarioDia.getText().trim());

        int diasTrabajados =
                (Integer) spnDiasTrabajados.getValue();

        double otrosIngresos = Double.parseDouble(
                txtOtrosIngresos.getText().trim());

        double pagosSalud = Double.parseDouble(
                txtPagosSalud.getText().trim());

        double aportePensiones = Double.parseDouble(
                txtAportePensiones.getText().trim());

        if (salarioDia < 0 || otrosIngresos < 0
                || pagosSalud < 0 || aportePensiones < 0
                || !Double.isFinite(salarioDia)
                || !Double.isFinite(otrosIngresos)
                || !Double.isFinite(pagosSalud)
                || !Double.isFinite(aportePensiones)) {

            javax.swing.JOptionPane.showMessageDialog(
                    this,
                    "Los valores monetarios deben ser números válidos "
                    + "y no negativos.",
                    "Error",
                    javax.swing.JOptionPane.ERROR_MESSAGE);
            return;
        }

        Empleado empleado = new Empleado(
                nombre,
                apellidos,
                cargo,
                genero,
                salarioDia,
                diasTrabajados,
                otrosIngresos,
                pagosSalud,
                aportePensiones);

        lista.agregarEmpleado(empleado);

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "El empleado ha sido agregado correctamente.",
                "Mensaje",
                javax.swing.JOptionPane.INFORMATION_MESSAGE);

    } catch (NumberFormatException e) {

        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Verifique los campos numéricos. "
                + "No deben estar vacíos ni contener letras.",
                "Error",
                javax.swing.JOptionPane.ERROR_MESSAGE);
    }

    }                                          

