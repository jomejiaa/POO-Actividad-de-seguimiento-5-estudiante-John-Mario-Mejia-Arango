    private void itemGuardarArchivoActionPerformed(java.awt.event.ActionEvent evt) {                                                   
    javax.swing.JFileChooser selector =
            new javax.swing.JFileChooser();

    selector.setFileSelectionMode(
            javax.swing.JFileChooser.DIRECTORIES_ONLY);

    selector.setDialogTitle(
            "Seleccione la carpeta para guardar la nómina");

    int respuesta = selector.showOpenDialog(this);

    if (respuesta == javax.swing.JFileChooser.APPROVE_OPTION) {

        java.io.File carpeta = selector.getSelectedFile();

        java.io.File archivo =
                new java.io.File(carpeta, "Nómina.txt");

        try {

            String contenido = empleados.convertirTexto();

            try (java.io.BufferedWriter escritor =
                    java.nio.file.Files.newBufferedWriter(
                            archivo.toPath(),
                            java.nio.charset.StandardCharsets.UTF_8)) {

                escritor.write(contenido);
            }

            javax.swing.JOptionPane.showMessageDialog(
                    this,
                    "El archivo Nómina.txt se ha guardado correctamente en:\n"
                    + archivo.getAbsolutePath(),
                    "Archivo guardado",
                    javax.swing.JOptionPane.INFORMATION_MESSAGE);

        } catch (java.io.IOException e) {

            javax.swing.JOptionPane.showMessageDialog(
                    this,
                    "No fue posible guardar el archivo.\n"
                    + e.getMessage(),
                    "Error",
                    javax.swing.JOptionPane.ERROR_MESSAGE);
        }
    }
    }                                                  

